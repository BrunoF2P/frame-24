# ==============================================================================
# Frame-24 — Environment Variables Example
# ==============================================================================

# Server
PORT=8080
ENV=development # development | staging | production
LOG_LEVEL=info  # debug | info | warn | error

# Database (PostgreSQL 16+)
DATABASE_URL=postgres://postgres:password@localhost:5432/frame24?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5

# Redis (Cache & Atomic Seat Locks)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=super-secret-key-change-in-production-min-32-chars
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Storage (Local / S3 Compatible)
STORAGE_DRIVER=local # local | s3
STORAGE_LOCAL_DIR=./uploads
# AWS_S3_BUCKET=frame24-media
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Fiscal Gateway (NFC-e / NFS-e)
FISCAL_GATEWAY_URL=https://api.gatewayfiscal.example.com
FISCAL_GATEWAY_TOKEN=
